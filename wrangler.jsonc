{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "unit-6-handswatter",
  "main": "worker.js",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
